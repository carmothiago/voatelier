# Vitória Oliver Atelier — template de variáveis de ambiente
#
# 1. Copie este arquivo para .env na raiz do projeto:
#       cp .env.example .env        (Linux/Mac)
#       copy .env.example .env      (Windows)
#
# 2. Preencha os valores conforme o seu ambiente.
# 3. NUNCA versione o arquivo .env — ele contém credenciais reais.

# --- Banco de dados ---
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=voatelier
DB_USERNAME=seu_usuario_mysql
DB_PASSWORD=sua_senha_mysql
DB_CHARSET=utf8mb4
